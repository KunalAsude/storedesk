# Copy to packages/db/.env (git-ignored). Used by db:generate, db:migrate, db:seed.
# Local Postgres from docker-compose.yml (bun run db:up). Neon is only for staging/production;
# never commit a real Neon connection string.
DATABASE_URL=postgres://storedesk:storedesk@localhost:5432/storedesk

# Seed users (bun run db:seed). Passwords: at least 8 characters; never commit real ones.
SEED_SUPERADMIN_NAME=Kunal
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Optional: Postgres used by `bun run test` (creates and drops throwaway databases).
# TEST_DATABASE_URL=postgres://storedesk:storedesk@localhost:5432/storedesk